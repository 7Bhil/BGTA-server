@page "/"
@attribute [Authorize]
@using BGTA.Server.Components.Dashboards
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@inject AuthenticationStateProvider AuthStateProvider
@inject ILogger<Index> Logger

<PageTitle>Tableau de Bord - BGTA</PageTitle>

<AuthorizeView>
    <Authorized>
        @if (isLoading)
        {
            <div class="d-flex flex-column align-center justify-center py-12 mt-8">
                <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
                <MudText Typo="Typo.body1" Class="mt-4 text-muted">Initialisation de votre tableau de bord...</MudText>
            </div>
        }
        else
        {
            @switch (currentProfilId)
            {
                case 1:  // Administrateur
                case 14: // ADMIN SOBEMAP
                case 17: // DSI
                    <AdminDashboard />
                    break;

                case 8:  // SERVICE FACTURATION
                case 9:  // SERVICE COMPTABILITE
                    <ComptabiliteDashboard />
                    break;

                case 2:  // POINTEUR
                case 3:  // CHAUFFEUR
                case 12: // SAH
                case 13: // USERPOCKET
                    <TerrainDashboard />
                    break;

                default: // Rôles métier standards, clients et repli
                    <GenericDashboard />
                    break;
            }
        }
    </Authorized>
</AuthorizeView>

@code {
    private int currentProfilId = 0;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                var profilIdClaim = user.FindFirst("ProfilId")?.Value;
                if (int.TryParse(profilIdClaim, out int profilId))
                {
                    currentProfilId = profilId;
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Erreur lors de l'aiguillage du tableau de bord");
        }
        finally
        {
            isLoading = false;
        }
    }
}