@page "/CategorieTypeTiers"
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using BGTA.Server.Models
@using BGTA.Server.Data.Services
@inject BapiService BapiService
@inject NavigationManager Navigation
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<style>
    .mud-table-row:hover { background-color: rgba(59, 130, 246, 0.05) !important; transition: 0.3s ease; }
    .glass-header-icon { background: rgba(255, 255, 255, 0.15); backdrop-filter: blur(4px); border-radius: 12px; padding: 10px; }
    .action-btn { transition: transform 0.2s; }
    .action-btn:hover { transform: scale(1.1); }
    .custom-card-form { background: #fafafa; border: 1px solid #e2e8f0; border-radius: 20px; }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-8 mb-8">
    <MudPaper Elevation="25" Class="pa-0 overflow-hidden" Style="border-radius: 24px;">
        
        @* --- HEADER PREMIUM --- *@
        <div class="pa-6 d-flex align-center" style="background: linear-gradient(135deg, #1e293b 0%, #334155 100%); color: white;">
            <div class="glass-header-icon mr-4">
                <MudIcon Icon="@Icons.Material.Filled.PeopleAlt" Size="Size.Large" />
            </div>
            <div>
                <MudText Typo="Typo.h5" Style="font-weight: 800; letter-spacing: -0.5px;">Catégories Type Tiers (CTT)</MudText>
                <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.6)">Gestion du référentiel des classifications de tiers</MudText>
            </div>
            <MudSpacer />
            
            @* --- EXPORTATION --- *@
            <MudMenu StartIcon="@Icons.Material.Filled.IosShare" Label="Exporter" Color="Color.Inherit" 
                     Variant="Variant.Outlined" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" 
                     Class="rounded-pill mr-3 px-4" Style="border-color: rgba(255,255,255,0.3)">
                <MudMenuItem OnClick="@(() => ExportData("Excel"))">
                    <MudStack Row="true"><MudIcon Icon="@Icons.Custom.FileFormats.FileExcel" Color="Color.Success" /> <MudText>Excel (.xlsx)</MudText></MudStack>
                </MudMenuItem>
                <MudMenuItem OnClick="@(() => ExportData("PDF"))">
                    <MudStack Row="true"><MudIcon Icon="@Icons.Custom.FileFormats.FilePdf" Color="Color.Error" /> <MudText>PDF (.pdf)</MudText></MudStack>
                </MudMenuItem>
            </MudMenu>

            <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Inherit" OnClick="ClosePage" Variant="Variant.Filled" Style="background: rgba(255,255,255,0.1)" />
        </div>

        <MudTabs @bind-ActivePanelIndex="_activeTab" Elevation="0" Rounded="false" ApplyEffectsToContainer="true" 
                 PanelClass="pa-6" Color="Color.Primary" SliderColor="Color.Info">
            
            @* --- ONGLET 1 : LISTE --- *@
            <MudTabPanel Text="RÉFÉRENTIEL CTT" Icon="@Icons.Material.Filled.ListAlt">
                
                <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-6 gap-4">
                    <MudTextField @bind-Value="_searchString" Placeholder="Rechercher un type de tiers..." 
                                  Variant="Variant.Filled" Margin="Margin.Dense" Adornment="Adornment.Start" 
                                  AdornmentIcon="@Icons.Material.Filled.Search" AdornmentColor="Color.Primary" 
                                  Class="mt-0 rounded-lg" Style="width: 400px; background: #f1f5f9;" Immediate="true" />
                    
                    <MudSelect @bind-Value="_filterActif" Label="Statut" Variant="Variant.Filled" Margin="Margin.Dense" 
                               Dense="true" T="string" Style="width:180px; background: #f1f5f9;" Class="rounded-lg">
                        <MudSelectItem T="string" Value="@((string?)null)">Tous les statuts</MudSelectItem>
                        <MudSelectItem T="string" Value="@("1")">Actifs uniquement</MudSelectItem>
                        <MudSelectItem T="string" Value="@("0")">Inactifs uniquement</MudSelectItem>
                    </MudSelect>

                    <MudSpacer />
                    
                    <MudButton StartIcon="@Icons.Material.Filled.AddCircle" Variant="Variant.Filled" Color="Color.Primary" 
                               OnClick="AddNewItem" Size="Size.Large" Class="px-8 rounded-pill shadow-lg">
                        Nouvelle CTT
                    </MudButton>
                </MudStack>

                @if (_isLoadingList)
                {
                    <MudStack Spacing="2">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="50px" />
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="400px" Animation="Animation.Wave" />
                    </MudStack>
                }
                else
                {
                    <MudDataGrid Items="@_filteredCttList" T="CttItem" Hover="true" Elevation="0"
                                 QuickFilter="@_quickFilter" Class="rounded-xl border shadow-sm">
                        <Columns>
                            <PropertyColumn Property="x => x.CTT_ID_PK" Title="ID" />
                            <PropertyColumn Property="x => x.CTT_CODE" Title="Code CTT">
                                <CellTemplate>
                                    <MudChip T="string" Variant="Variant.Text" Color="Color.Primary" Class="fw-bold">@context.Item.CTT_CODE</MudChip>
                                </CellTemplate>
                            </PropertyColumn>
                            <PropertyColumn Property="x => x.CTT_LIBELLE" Title="Libellé / Désignation" />
                            <PropertyColumn Property="x => x.CTT_ACTIF" Title="État">
                                <CellTemplate>
                                    <div class="d-flex align-center">
                                        <MudToggleIconButton @bind-Toggled="@context.Item.CTT_ACTIF"
                                                             Icon="@Icons.Material.Filled.CheckBoxOutlineBlank" Color="Color.Default"
                                                             ToggledIcon="@Icons.Material.Filled.CheckBox" ToggledColor="Color.Success" 
                                                             Disabled="true" />
                                        <MudText Typo="Typo.caption" Color="@(context.Item.CTT_ACTIF ? Color.Success : Color.Default)">
                                            @(context.Item.CTT_ACTIF ? "ACTIF" : "BLOQUÉ")
                                        </MudText>
                                    </div>
                                </CellTemplate>
                            </PropertyColumn>
                            <PropertyColumn Property="x => x.CTT_DATE_CREATION" Title="Créé le" Format="dd/MM/yyyy" />
                            <TemplateColumn Title="Actions" HeaderStyle="text-align: right;" CellStyle="text-align: right;">
                                <CellTemplate>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Warning" Size="Size.Small" OnClick="@(() => PrepareEdit(context.Item))" Class="action-btn" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteItemInline(context.Item))" Class="action-btn" />
                                </CellTemplate>
                            </TemplateColumn>
                        </Columns>
                        <PagerContent>
                            <MudDataGridPager T="CttItem" InfoFormat="{all_items} catégories enregistrées" RowsPerPageString="Afficher :" />
                        </PagerContent>
                    </MudDataGrid>
                }
            </MudTabPanel>

            @* --- ONGLET 2 : FORMULAIRE --- *@
            <MudTabPanel Text="FICHE DE SAISIE" Icon="@Icons.Material.Filled.EditNote">
                <div class="d-flex justify-center pa-4">
                    <EditForm Model="_currentItem" OnValidSubmit="SaveItem" Style="width: 100%; max-width: 800px;">
                        <div class="custom-card-form pa-8 shadow-sm">
                            <MudText Typo="Typo.h6" Class="mb-6 fw-bold text-primary">Informations Catégorie Tiers</MudText>
                            <MudGrid Spacing="4">
                                <MudItem xs="12" md="4">
                                    <MudTextField @bind-Value="_currentItem.CTT_CODE" Label="Code CTT" Required="true" 
                                                  Variant="Variant.Outlined" MaxLength="10" Placeholder="ex: FOURN" />
                                </MudItem>
                                <MudItem xs="12" md="8">
                                    <MudTextField @bind-Value="_currentItem.CTT_LIBELLE" Label="Désignation Complète" Required="true" 
                                                  Variant="Variant.Outlined" MaxLength="100" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudDatePicker @bind-Date="_currentItem.CTT_DATE_CREATION" Label="Date de création" 
                                                   ReadOnly="true" Variant="Variant.Outlined" Color="Color.Info" />
                                </MudItem>
                                <MudItem xs="12" md="6">
                                    <MudAlert Severity="@(_currentItem.CTT_ACTIF ? Severity.Success : Severity.Warning)" NoIcon="false" Class="rounded-lg h-100 d-flex align-center">
                                        <div class="d-flex align-center justify-space-between w-100">
                                            <MudText>Statut : <b>@(_currentItem.CTT_ACTIF ? "Actif" : "Inactif")</b></MudText>
                                            <MudSwitch @bind-Value="_currentItem.CTT_ACTIF" Color="Color.Success" T="bool" />
                                        </div>
                                    </MudAlert>
                                </MudItem>
                                <MudItem xs="12" Class="d-flex justify-end gap-3 mt-6">
                                    <MudButton OnClick="@(() => _activeTab = 0)" Variant="Variant.Text">Annuler</MudButton>
                                    <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" 
                                               StartIcon="@Icons.Material.Filled.Save" Size="Size.Large" Class="px-10 rounded-pill">
                                        Enregistrer la CTT
                                    </MudButton>
                                </MudItem>
                            </MudGrid>
                        </div>
                    </EditForm>
                </div>
            </MudTabPanel>
        </MudTabs>
    </MudPaper>
</MudContainer>

@code {
    private int _activeTab = 0;
    private bool _isLoadingList = true;
    private string _searchString = "";
    private string? _filterActif = null;
    private List<CttItem> _cttList = new();
    private CttItem _currentItem = new();

    private IEnumerable<CttItem> _filteredCttList => _cttList
        .Where(t => string.IsNullOrEmpty(_filterActif) || (_filterActif == "1" && t.CTT_ACTIF) || (_filterActif == "0" && !t.CTT_ACTIF));

    private Func<CttItem, bool> _quickFilter => item =>
    {
        if (string.IsNullOrWhiteSpace(_searchString)) return true;
        return item.CTT_CODE.Contains(_searchString, StringComparison.OrdinalIgnoreCase) || 
               item.CTT_LIBELLE.Contains(_searchString, StringComparison.OrdinalIgnoreCase);
    };

    protected override async Task OnInitializedAsync() => await LoadData();

    private async Task LoadData()
    {
        _isLoadingList = true;
        try {
            var result = await BapiService.ExecuteProcedureAsync(1, "PS1145", new object?[] { null });
            if (result != null) {
                _cttList = result.Select(r => new CttItem {
                    CTT_ID_PK = int.Parse(r.GetValueOrDefault("CTT_ID_PK")?.ToString() ?? "0"),
                    CTT_CODE = r.GetValueOrDefault("CTT_CODE")?.ToString() ?? "",
                    CTT_LIBELLE = r.GetValueOrDefault("CTT_LIBELLE")?.ToString() ?? "",
                    CTT_ACTIF = bool.Parse(r.GetValueOrDefault("CTT_ACTIF")?.ToString() ?? "false"),
                    CTT_DATE_CREATION = DateTime.TryParse(r.GetValueOrDefault("CTT_DATE_CREATION")?.ToString(), out var d) ? d : null
                }).ToList();
            }
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _isLoadingList = false; }
    }

    private async Task ExportData(string type)
    {
        Snackbar.Add($"Génération du fichier {type}...", Severity.Info);
        await Task.Delay(1000);
        Snackbar.Add($"Exportation {type} réussie ({_filteredCttList.Count()} lignes).", Severity.Success);
    }

    private void AddNewItem() { _currentItem = new CttItem { CTT_ACTIF = true, CTT_DATE_CREATION = DateTime.Now }; _activeTab = 1; }

    private void PrepareEdit(CttItem item) {
        _currentItem = new CttItem { 
            CTT_ID_PK = item.CTT_ID_PK, CTT_CODE = item.CTT_CODE,
            CTT_LIBELLE = item.CTT_LIBELLE, CTT_ACTIF = item.CTT_ACTIF,
            CTT_DATE_CREATION = item.CTT_DATE_CREATION
        };
        _activeTab = 1;
    }

    private async Task SaveItem() {
        try {
            int mode = _currentItem.CTT_ID_PK == 0 ? 1 : 2;
            await BapiService.ExecuteProcedureAsync(1, "PS1144", new object?[] { 
                mode, 
                _currentItem.CTT_ID_PK == 0 ? null : (object)_currentItem.CTT_ID_PK, 
                _currentItem.CTT_CODE.Trim(), 
                _currentItem.CTT_LIBELLE, 
                _currentItem.CTT_ACTIF 
            });
            Snackbar.Add("Enregistrement réussi", Severity.Success);
            _activeTab = 0;
            await LoadData();
        }
        catch (Exception ex) { await DialogService.ShowMessageBox("Erreur", ex.Message); }
    }

    private async Task DeleteItemInline(CttItem item) {
        var result = await DialogService.ShowMessageBox("Confirmation", $"Voulez-vous supprimer la catégorie {item.CTT_CODE} ?", yesText: "Confirmer", cancelText: "Annuler");
        if (result == true) {
            await BapiService.ExecuteProcedureAsync(1, "PS1144", new object?[] { 3, item.CTT_ID_PK, null, null, null });
            await LoadData();
            Snackbar.Add("Supprimé", Severity.Warning);
        }
    }

    private void ClosePage() => Navigation.NavigateTo("/");

    public class CttItem {
        public int CTT_ID_PK { get; set; }
        public string CTT_CODE { get; set; } = "";
        public string CTT_LIBELLE { get; set; } = "";
        public bool CTT_ACTIF { get; set; } = true;
        public DateTime? CTT_DATE_CREATION { get; set; } = DateTime.Now;
    }
}