@using BGTA.Server.Services
@using BGTA.Server.Models
@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@inject NavigationManager Navigation
@inject IMenuService MenuService
@inject AuthenticationStateProvider AuthStateProvider

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 mb-8">
    <MudPaper Elevation="0" Class="pa-6 rounded-xl border mb-6" Style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); color: white;">
        <div class="d-flex align-center justify-space-between flex-wrap gap-4">
            <div>
                <MudText Typo="Typo.h5" Style="font-weight: 800;">Tableau de Bord Général</MudText>
                <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.7);">Accès rapide aux modules métiers du système BGTA</MudText>
            </div>
            <MudChip T="string" Color="Color.Info" Variant="Variant.Filled" Size="Size.Medium" Class="px-4 fw-bold">
                Marchés Publics & Engagement
            </MudChip>
        </div>
    </MudPaper>

    @if (isLoading)
    {
        <div class="d-flex flex-column align-center justify-center py-12">
            <MudProgressCircular Color="Color.Primary" Size="Size.Large" Indeterminate="true" />
            <MudText Typo="Typo.body2" Class="mt-4 text-muted">Chargement de votre tableau de bord...</MudText>
        </div>
    }
    else if (dashboardLinks == null || !dashboardLinks.Any())
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="rounded-xl pa-4">
            Aucun raccourci n'est configuré pour votre profil d'accès. Utilisez le menu latéral pour naviguer dans l'application.
        </MudAlert>
    }
    else
    {
        <MudGrid Spacing="4">
            @foreach (var link in dashboardLinks)
            {
                <MudItem xs="12" sm="6" md="4" lg="3">
                    <MudCard Elevation="2" Class="rounded-xl border h-100 d-flex flex-column justify-space-between transition-all hover-elevation-6">
                        <MudCardContent Class="pa-5">
                            <div class="d-flex align-center mb-3">
                                <div class="pa-3 rounded-lg mr-3" style="background: rgba(59, 130, 246, 0.1); color: #2563eb;">
                                    <MudIcon Icon="@GetIcon(link.Icon)" Size="Size.Medium" />
                                </div>
                                <MudText Typo="Typo.subtitle1" Style="font-weight: 700; color: #1e293b;">
                                    @link.Text
                                </MudText>
                            </div>
                            <MudText Typo="Typo.body2" Class="text-muted mb-4" Style="min-height: 40px;">
                                @(string.IsNullOrWhiteSpace(link.DescriptionMenu) ? "Accéder directement au module de gestion" : link.DescriptionMenu)
                            </MudText>
                        </MudCardContent>
                        <div class="pa-4 pt-0">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       FullWidth="true"
                                       EndIcon="@Icons.Material.Filled.ArrowForward"
                                       OnClick="@(() => NavigateToItem(link.Url))"
                                       Class="rounded-pill py-2">
                                Accéder
                            </MudButton>
                        </div>
                    </MudCard>
                </MudItem>
            }
        </MudGrid>
    }
</MudContainer>

@code {
    private List<MenuItem>? dashboardLinks;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                var allMenus = await MenuService.GetMenuItemsAsync();
                dashboardLinks = allMenus?.Where(m => m.MenuRaccourci).ToList() ?? new List<MenuItem>();
            }
            else
            {
                dashboardLinks = new List<MenuItem>();
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[GenericDashboard] Erreur chargement: {ex.Message}");
            dashboardLinks = new List<MenuItem>();
        }
        finally
        {
            isLoading = false;
        }
    }

    private void NavigateToItem(string? url)
    {
        if (!string.IsNullOrEmpty(url))
        {
            Navigation.NavigateTo(url);
        }
    }

    private string GetIcon(string? iconName)
    {
        if (string.IsNullOrWhiteSpace(iconName))
            return Icons.Material.Filled.Dashboard;

        return iconName switch
        {
            "fas fa-home" or "home.png" => Icons.Material.Filled.Home,
            "fas fa-tasks" or "tasks.png" => Icons.Material.Filled.Assignment,
            "fas fa-file-contract" or "file-contract.png" => Icons.Material.Filled.Description,
            "fas fa-user" or "user.png" => Icons.Material.Filled.Person,
            "fas fa-cog" or "cog.png" => Icons.Material.Filled.Settings,
            "fas fa-chart-bar" or "chart-bar.png" => Icons.Material.Filled.BarChart,
            "fas fa-shield-alt" or "shield-alt.png" => Icons.Material.Filled.Security,
            _ => Icons.Material.Filled.Apps
        };
    }
}
