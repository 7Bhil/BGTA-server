@using BGTA.Server.Services
@using BGTA.Server.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager Navigation
@inject IMenuService MenuService
@inject AuthenticationStateProvider AuthStateProvider

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">BGTA</a>
    </div>
</div>

@if (menuItems == null)
{
    <div class="px-3 py-2 text-center">
        <div class="spinner-border spinner-border-sm text-primary" role="status">
            <span class="visually-hidden">Chargement...</span>
        </div>
    </div>
}
else
{
    <div class="navbar-nav flex-column">
        @foreach (var item in menuItems)
        {
            <MenuNode Item="item" Level="0" OnNavigate="NavigateToUrl" />
        }
    </div>
}

@code {
    private List<MenuItem>? menuItems;

    protected override async Task OnInitializedAsync()
    {
        // Récupération sécurisée de l'ID Profil depuis les claims
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var profilIdClaim = authState.User.FindFirst("ProfilId")?.Value;
        
        int.TryParse(profilIdClaim, out int profilId);
        
        // Chargement du menu
        menuItems = await MenuService.GetMenuItemsAsync();
    }

    private void NavigateToUrl(string? url)
    {
        if (!string.IsNullOrEmpty(url) && url != "#" && !url.StartsWith("#menu-"))
        {
            Navigation.NavigateTo(url);
        }
    }
}

<style>
    /* Force le texte du menu en blanc et améliore l'espacement */
    .navbar-nav .nav-item .nav-link {
        color: #ffffff !important;
        font-size: 0.95rem;
        padding: 0.75rem 1rem;
        transition: background-color 0.2s;
    }

    /* Effet visuel au survol pour savoir oÃ¹ l'utilisateur se trouve */
    .navbar-nav .nav-item .nav-link:hover {
        background-color: rgba(255, 255, 255, 0.15);
        color: #ffffff !important;
    }

    /* Optionnel : Style pour vos icônes */
    .navbar-nav .nav-item .nav-link i {
        margin-right: 10px;
        color: #7289da; /* Une couleur d'accentuation pour les icônes */
        width: 20px;
        text-align: center;
    }


    /* 1. Conteneur principal */
    .navbar-nav {
        padding: 15px 0;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    /* 2. Style des liens */
    .nav-link {
        display: flex !important;
        align-items: center;
        padding: 12px 20px !important;
        color: #94a3b8 !important; /* Gris doux au repos */
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border-left: 4px solid transparent;
        font-size: 0.95rem;
        letter-spacing: 0.3px;
    }

    /* 3. Effet au survol et actif */
    .nav-link:hover, .nav-link.active {
        color: #ffffff !important;
        background: rgba(255, 255, 255, 0.05);
        border-left-color: #38bdf8; /* Accent bleu électrique */
    }

    /* 4. Gestion des icônes */
    .nav-link i {
        margin-right: 15px;
        width: 20px;
        text-align: center;
        font-size: 1.1rem;
        opacity: 0.7;
    }

    .nav-link:hover i {
        opacity: 1;
        transform: translateX(3px); /* Petit effet de mouvement */
    }

    /* 5. Séparateur de section */
    .menu-divider {
        height: 1px;
        background: rgba(255, 255, 255, 0.1);
        margin: 10px 20px;
    }

</style>