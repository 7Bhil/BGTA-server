@using BGTA.Server.Models
@inject NavigationManager Navigation

@if (Item.Children?.Count > 0)
{
    <div class="nav-item">
        <div class="nav-link @GetActiveClass()" style="cursor:pointer;" @onclick="ToggleExpand">
            <span class="me-2">@Item.Text</span>
            <span class="float-end">@((IsExpanded ? "â–²" : "â–¼"))</span>
        </div>
        @if (IsExpanded)
        {
            <div class="nav flex-column ms-3" style="display:block !important;">
                @foreach (var child in Item.Children.OrderBy(c => c.Order))
                {
                    <MenuNode Item="child" Level="@(Level + 1)" OnNavigate="OnNavigate" />
                }
            </div>
        }
    </div>
}
else
{
    <div class="nav-item">
        <a class="nav-link @GetActiveClass()" href="@Item.Url" @onclick="HandleClick">
            <span class="me-2">@Item.Text</span>
        </a>
    </div>
}

@code {
    [Parameter, EditorRequired] public MenuItem Item { get; set; } = new();
    [Parameter] public int Level { get; set; }
    [Parameter] public EventCallback<string?> OnNavigate { get; set; }

    private bool IsExpanded { get; set; }

    private void ToggleExpand() => IsExpanded = !IsExpanded;

    private void HandleClick()
    {
        if (!string.IsNullOrEmpty(Item.Url) && Item.Url != "#")
        {
            OnNavigate.InvokeAsync(Item.Url);
        }
        else if (Item.Children?.Count > 0)
        {
            ToggleExpand();
        }
    }

    private string GetActiveClass()
    {
        var currentPath = Navigation.Uri.Replace(Navigation.BaseUri, "/");
        return !string.IsNullOrEmpty(Item.Url) && currentPath.StartsWith(Item.Url) ? "active" : "";
    }
}