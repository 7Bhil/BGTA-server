@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="/">BGTA</a>
    </div>
</div>

<div class="navbar-nav flex-column">
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="/" Match="NavLinkMatch.All">
            <span class="fas fa-home fa-fw me-2"></span> Accueil
        </NavLink>
    </div>
    
    <AuthorizeView>
        <Authorized>
            @* Liens visibles par tous les utilisateurs connectés *@
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/pta">
                    <span class="fas fa-tasks fa-fw me-2"></span> Plans de Travail Annuels
                </NavLink>
            </div>
            
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/plan">
                    <span class="fas fa-file-contract fa-fw me-2"></span> Plans de Passation
                </NavLink>
            </div>
            
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/rapports">
                    <span class="fas fa-chart-bar fa-fw me-2"></span> Rapports
                </NavLink>
            </div>
            
            @* Section spécifique aux Administrateurs - Utilisation de Context pour éviter le conflit *@
            <AuthorizeView Roles="Administrateur" Context="adminContext">
                <Authorized>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="/admin">
                            <span class="fas fa-cog fa-fw me-2"></span> Administration
                        </NavLink>
                    </div>
                </Authorized>
            </AuthorizeView>
        </Authorized>

        <NotAuthorized>
            @* Visible uniquement si non connecté *@
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="/Login">
                    <span class="fas fa-sign-in-alt fa-fw me-2"></span> Connexion
                </NavLink>
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

@* Gardez votre bloc <style> tel quel en dessous *@